#!/bin/sh
# ------------------------------------------------------------------
# 轻量 Maven Wrapper(Linux / macOS / Git Bash)
# 无需预装 Maven,仅需 JDK 17;优先复用 PATH 上已有的 mvn
# 用法与 mvn 相同:./mvnw clean package
# ------------------------------------------------------------------
set -e

MAVEN_VERSION=3.9.6
DIST_ROOT="${HOME}/.m2/wrapper/dists"
DIST_DIR="${DIST_ROOT}/apache-maven-${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}"

# Maven 需要 JAVA_HOME;若未设置则从 PATH 上的 java 推导
if [ -z "${JAVA_HOME}" ]; then
  if command -v java >/dev/null 2>&1; then
    JAVA_HOME=$(cd "$(dirname "$(command -v java)")/.." && pwd)
    export JAVA_HOME
  fi
fi

# 本机已安装 Maven 则直接使用
if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

if [ ! -f "${DIST_DIR}/bin/mvn" ]; then
  echo "[mvnw] 本地未安装 Maven,开始下载 apache-maven-${MAVEN_VERSION}(约 9MB,仅首次)..."
  mkdir -p "${DIST_ROOT}/apache-maven-${MAVEN_VERSION}"
  cd "${DIST_ROOT}/apache-maven-${MAVEN_VERSION}"
  ZIP="apache-maven-${MAVEN_VERSION}-bin.zip"
  URL1="https://maven.aliyun.com/repository/central/org/apache/maven/apache-maven/${MAVEN_VERSION}/${ZIP}"
  URL2="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/${ZIP}"
  curl -fsSL --retry 3 -o "${ZIP}" "${URL1}" || curl -fsSL --retry 3 -o "${ZIP}" "${URL2}"
  if command -v unzip >/dev/null 2>&1; then
    unzip -q -o "${ZIP}"
  elif command -v jar >/dev/null 2>&1; then
    jar -xf "${ZIP}"
  else
    powershell -NoProfile -Command "Expand-Archive -Force '${ZIP}' '.'"
  fi
  rm -f "${ZIP}"
fi

exec "${DIST_DIR}/bin/mvn" "$@"
